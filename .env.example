# ==============================================================================
# Medicare Production Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values before deploying.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Database (Postgres) ---
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password
DB_HOST=db
DB_PORT=5432
DB_NAME=medicare

# --- Security ---
# Generate a strong random secret (e.g. openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string

# --- CORS ---
# Set to your production frontend domain (with https://).
# The backend will only accept requests from this origin in production.
# Example: https://medicare.cometchat-staging.com
CORS_ORIGIN=https://medicare.cometchat-staging.com

# --- Docker Compose: Port Binding ---
# Production (behind nginx/ALB on same host): leave as 127.0.0.1 (default).
# Local LAN testing (phone/emulator hitting the API directly): set to 0.0.0.0
APP_BIND=127.0.0.1

# --- Web Push Notifications (VAPID) ---
# These are required for browser/web push notifications.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Firebase Cloud Messaging (Mobile Push Notifications) ---
# Required for push notifications on iOS and Android.
# Option 1: Place firebase-service-account.json in backend/config/
# Option 2: Paste the entire service account JSON as a single-line string below.
FIREBASE_SERVICE_ACCOUNT=

# --- CometChat (In-App Chat) ---
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_AUTH_KEY=
COMETCHAT_REST_API_KEY=

# --- Mobile App (build-time variable) ---
# The production API URL the mobile app connects to.
# Set this when building the mobile app with EAS or locally:
#   EXPO_PUBLIC_API_URL=https://medicare.cometchat-staging.com eas build ...
# If not set, the mobile app defaults to https://medicare.cometchat-staging.com
EXPO_PUBLIC_API_URL=https://medicare.cometchat-staging.com
