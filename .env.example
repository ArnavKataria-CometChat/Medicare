# Database
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_HOST=db
DB_PORT=5432
DB_NAME=medicare

# Security
JWT_SECRET=change_this_to_a_secure_random_string

# CORS — restrict to your production domain
# Example: https://medicare.yourdomain.com
CORS_ORIGIN=*

# VAPID Keys (for Web Push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Firebase (for Mobile Push Notifications)
# Option 1: Place firebase-service-account.json in backend/config/
# Option 2: Paste the entire JSON content as a single-line string below
FIREBASE_SERVICE_ACCOUNT=

# CometChat
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_AUTH_KEY=
COMETCHAT_REST_API_KEY=
COMETCHAT_WEBHOOK_SECRET=
